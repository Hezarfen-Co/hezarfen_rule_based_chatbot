# systemd KULLANICI unit'i: Çelebi köprüsünü podman compose ile çalıştırır.
# %h/hezarfen_rule_based_chatbot içinde beklenen dosyalar:
#   compose.yaml                     bu repodan (ya da deploy artefaktından)
#   hezarfen_rule_based_chatbot.env             0600, deploy/hezarfen_rule_based_chatbot.env.example'dan
#                                    ELLE yazılır — otomasyon oluşturmaz/ezmez
#   stack.env                        deploy sahipli; HEZARFEN_TAG taşır
#
# Unit `--no-build` ile başlar, yani imaj sunucuda zaten olmalı:
#   podman compose build             # burada derle
#   podman load -i image.tar         # ya da hazır imajı yükle
#
# hezarfen_rule_based_chatbot.env içindeki anahtarlar (tam belge: deploy/hezarfen_rule_based_chatbot.env.example).
# Hepsinin varsayılanı imajın ENV bloğundadır (Containerfile) — bu dosya ezer:
#   AI_BRIDGE_HOST / AI_BRIDGE_PORT   backend'in QUIC dinleyicisi (ağ içi ad)
#   AI_BACKEND_URL                    sertifikanın çekildiği HTTP kökü
#   AI_SHARED_TOKEN                   backend ile AYNI olmalı
#   HEZARFEN_ASSISTANT_ROLE           yedek rol
#
# Sadece ortam değişkeni değiştiğinde yeniden başlatma (ExecStart'ı yeniden
# koşar, ortamı değişen konteynerı yeniden oluşturur):
#   systemctl --user restart hezarfen_rule_based_chatbot_compose

[Unit]
Description=Hezarfen Celebi QUIC bridge (rule-based chatbot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/hezarfen_rule_based_chatbot
# İKİ `--env-file` YASAK. podman-compose 1.6.0 `--env-file`ı TEK DEĞER sayar
# (podman_compose.py:2941-2946) ve verildiğinde YALNIZCA SONUNCUSUNU okur: iki
# bayrak operatörün ayar dosyasını sessizce düşürür, yani `${HEZARFEN_NET:-...}`
# interpolasyonu compose varsayılanına kayar. Operatör değerleri ORTAMDAN gelir
# (`EnvironmentFile=`), compose'a giden TEK `--env-file` deploy sahipli
# stack.env'dir (HEZARFEN_TAG). Ortam değişkeni --env-file değerlerini EZER
# (:2562), yani iki kanal çakışmaz. Docker Compose v2'nin "sonraki dosya
# çakışan anahtarda kazanır" davranışı bu sağlayıcı için GEÇERLİ DEĞİL.
EnvironmentFile=%h/hezarfen_rule_based_chatbot/hezarfen_rule_based_chatbot.env
ExecStart=/usr/bin/podman compose --env-file %h/hezarfen_rule_based_chatbot/stack.env up -d --no-build
# -v yok: isimli volume'lar stop'ta yaşamalı (köprü durumsuzdur ama şekil aynı).
ExecStop=/usr/bin/podman compose --env-file %h/hezarfen_rule_based_chatbot/stack.env down
TimeoutStartSec=180

[Install]
WantedBy=default.target
