# hezarfen_rule_based_chatbot.env — Çelebi köprüsünün sunucu ayarları.
#
# Sunucuda TEK SEFERLİK, elle:
#   mkdir -p ~/hezarfen_rule_based_chatbot
#   cp hezarfen_rule_based_chatbot.env.example ~/hezarfen_rule_based_chatbot/hezarfen_rule_based_chatbot.env
#   <değerleri doldur>
#   chmod 0600 ~/hezarfen_rule_based_chatbot/hezarfen_rule_based_chatbot.env
#
# Hiçbir otomasyon bu dosyayı oluşturmaz, ezmez, yüklemez — operatörün malıdır;
# compose yalnız okur (`env_file`). Satırlar düz KEY=value: tırnak yok, `export`
# yok, satır sonu yorumu yok.
#
# Buradaki her anahtar Containerfile ENV bloğundaki varsayılanı EZER. Değerler
# konteyner BAŞLARKEN okunur: değişiklikten sonra yeniden oluştur
# (`podman compose up -d` ya da `systemctl --user restart hezarfen_rule_based_chatbot_compose`).

# ── Backend tarafı (ZORUNLU: ikisi backend ile aynı olmalı) ───────────────────
# Backend'in QUIC köprüsü dinleyicisi. hezarfen_backend.env içinde
# AI_QUIC_ADDR=0.0.0.0:8090 OLMALI — 127.0.0.1 yazılıysa backend yalnız kendi
# konteyner loopback'ine bağlanır ve HİÇBİR servis dial-in edemez (Çelebi 503
# "no AI service is connected" verir). Değiştirdikten sonra:
#   systemctl --user restart hezarfen_backend_compose
AI_BRIDGE_HOST=hezarfen_backend
AI_BRIDGE_PORT=8090

# Sertifikanın çekildiği HTTP kökü — backend konteynerinin kendi portu.
AI_BACKEND_URL=http://hezarfen_backend:7656

# Paylaşılan sır: backend'in AI_SHARED_TOKEN'ı ile BİREBİR aynı olmalı.
# 'change-me' yalnız geliştirme değeridir; prod'da iki tarafı birlikte değiştir.
AI_SHARED_TOKEN=change-me

# ── Servis kimliği ────────────────────────────────────────────────────────────
# Sertifikadaki SAN (self-signed, backend her açılışta yeniler).
AI_TLS_SERVER_NAME=localhost
# Sertifika parmak izi pinlemesi — backend sertifikası DÜZ HTTP ile çekildiği
# için tek başına pinlemek yetmez: araya giren biri kendi sertifikasını
# pinletebilir. BOŞ BIRAKILIRSA TOFU (her açılışta loglanır). Üretimde doldurun
# — 64 onaltılık karakter, iki nokta ayraçları atılır, büyük/küçük harf farkı
# yok. Değeri sunucuda:
#   curl -s http://127.0.0.1:7656/ai/certificate | jq -r .fingerprint_sha256
# Yanlış/yarım bir değer sessizce TOFU'ya DÜŞMEZ: köprü yapılandırma hatasıyla
# durur (yanlış olduğunu bilmeden pinlediğini sanmasın).
AI_TLS_FINGERPRINT=
# Loglarda ve backend kaydında görünen ad.
AI_SERVICE_NAME=celebi
# Backend rol göndermezse kullanılacak yedek rol (ziyaretci|veli|ogrenci|ogretmen|yonetici|admin).
HEZARFEN_ASSISTANT_ROLE=ogrenci

# ── Dayanıklılık ──────────────────────────────────────────────────────────────
# Aynı anda kabul edilen istek ve kopunca yeniden deneme aralığı (saniye).
AI_MAX_CONCURRENT=8
# AI_RECONNECT_SECS tabandır; her başarısız turda ikiye katlanır ve
# AI_RECONNECT_MAX_SECS'te durur (jitter eklenir). Kayıt kalıcı olarak
# reddedilirse (unsupported_protocol/unauthorized) doğrudan tavana çekilir:
# köprü ÇIKMAZ, bekler ve yapılandırma düzelince kendiliğinden kaydolur.
AI_RECONNECT_SECS=3
AI_RECONNECT_MAX_SECS=120

# ── Sürüm etiketi ─────────────────────────────────────────────────────────────
# BURADAN OKUNMAZ: HEZARFEN_TAG yalnız compose interpolasyonudur ve deploy'un
# sahip olduğu stack.env içinde taşınır (ikinci `--env-file`, çakışan anahtarda
# o kazanır). Unit `--no-build` ile başlar, yani imaj sunucuda VAR olmalı:
#   podman compose build          # burada derle
#   podman load -i image.tar      # ya da hazır imajı yükle
#HEZARFEN_TAG=latest
